{
  "name": "wp-plugin-e2e",
  "private": true,
  "description": "Reusable Playwright end-to-end tests for a WordPress plugin on LocalWP (not shipped with the plugin)",
  "scripts": {
    "setup": "node setup/setup.mjs",
    "local:fixture": "node setup/setup.mjs --fixture-only",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "dotenv": "^18.0.8"
  }
}
